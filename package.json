{
  "name": "cardet-license-manager",
  "version": "0.1.0",
  "private": true,
  "description": "CARDET software license & subscription manager (prototype)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "import-xlsx": "node scripts/import-xlsx.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mantine/charts": "^9.8.0",
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^8.3.8"
  }
}
